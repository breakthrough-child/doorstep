{
  "name": "doorstep",
  "version": "0.1.0",
  "private": true,
  "description": "A caretaking companion for families looking after a parent who lives alone, built on the Ring Partner API and Amazon Bedrock.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "setup": "tsx scripts/setup.ts",
    "record": "tsx scripts/record-fixtures.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "check:bedrock": "tsx scripts/check-bedrock.ts",
    "submission:no-aws": "node scripts/submission-no-aws.mjs",
    "stock": "python3 -I scripts/stockify.py"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "better-sqlite3": "^11.10.0",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
