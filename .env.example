# Copy to .env.local and fill in what you need. Everything is optional for a first run:
# with no variables set, Doorstep starts in REPLAY mode with Bedrock in mock mode.

# --- Data mode -----------------------------------------------------------------
# LIVE     = call the real Ring Partner API (Developer Playground) with RING_ACCESS_TOKEN
# REPLAY   = serve recorded Playground responses from fixtures/ (default)
# SCENARIO = play timed synthetic events (labelled "simulated") over replayed device data
# The /demo panel can switch modes at runtime; this is only the default.
DATA_MODE=REPLAY

# --- Ring Partner API ----------------------------------------------------------------
# Generate a token in the Ring Developer Playground (https://developer.amazon.com/ring/console/playground).
# Playground tokens last ~30 minutes. You can also paste one in the app (onboarding or the
# "token expired" banner) — a pasted token takes precedence over this variable.
RING_ACCESS_TOKEN=
# How often LIVE mode polls event history (seconds). Playground doesn't deliver webhooks.
LIVE_POLL_SECONDS=30

# --- Amazon Bedrock -------------------------------------------------------------------
# Standard AWS credential chain (env vars, ~/.aws/credentials, SSO profile…).
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# Vision + text model. Default: Amazon Nova Lite via the EU cross-region inference profile.
# In us-east-1 use us.amazon.nova-lite-v1:0 instead. Check access with: npm run check:bedrock
BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0
# Optional: call Bedrock in a different region from AWS_REGION.
# BEDROCK_REGION=eu-north-1
# 1 = sample captions/digests, never call AWS (offline development).
# Unset (default) = call Bedrock whenever AWS credentials are found. If calls fail (quota, access,
# network), Doorstep shows labelled sample captions and retries every few minutes, switching to
# real Nova Lite captions automatically once a call succeeds.
# BEDROCK_MOCK=

# --- App ----------------------------------------------------------------------------
# Default time zone for the parent (editable in Care plan).
DEFAULT_TIME_ZONE=Africa/Lagos
# Background poller interval (ms). Set DOORSTEP_POLLER=0 to disable it (the UI still ticks the pipeline).
POLLER_INTERVAL_MS=1500
# DOORSTEP_POLLER=0
# Where SQLite + downloaded snapshots live.
# DOORSTEP_DATA_DIR=data
# Use a different fixtures folder for REPLAY (default: fixtures/playground).
# FIXTURE_DIR=fixtures/playground
# Per-address connect timeout for IPv6/IPv4 racing (ms). Node's 250 ms default fails on slow links.
# NET_FAMILY_ATTEMPT_TIMEOUT_MS=2500

